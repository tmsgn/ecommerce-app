rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products - public read, only authenticated users can write (needed for seeding)
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Users - only the authenticated user can read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /cart/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /wishlist/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /orders/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /addresses/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /paymentMethods/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}